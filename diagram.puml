@startuml
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

title Online Marketplace - Observer + Visitor

package "observer.api" {
    enum EventType {
        PRICE_CHANGED
        STOCK_CHANGED
        MARKET_TREND
        INSPECTION_REPORT
    }
    interface Event {
        +eventType(): EventType
        +timestamp(): Instant
    }
    interface "Observer<E extends Event>" as Observer {
        +onEvent(event: E): void
    }
    interface "Subject<E extends Event>" as Subject {
        +subscribe(type: EventType, o: Observer<? super E>): void
        +unsubscribe(type: EventType, o: Observer<? super E>): void
        +notifyObservers(event: E): void
    }
}

package "observer.events" <<record>> {
    class PriceChangedEvent
    class StockChangedEvent
    class MarketTrendEvent
    class InspectionReportEvent {
        categoryId: String
        discountPercent: double
        report: InventoryReport
    }
}
Event <|.. PriceChangedEvent
Event <|.. StockChangedEvent
Event <|.. MarketTrendEvent
Event <|.. InspectionReportEvent

package "observer.subjects" {
    abstract class "AbstractSubject<E>" as AbstractSubject {
        -listeners: EnumMap<EventType, CopyOnWriteArrayList<Observer<? super E>>>
        -failedDeliveries: AtomicInteger
    }
    class PriceService {
        +updatePrice(productId, categoryId, newPrice: Money)
    }
    class InventoryService {
        +updateStock(productId, categoryId, newStock: int)
    }
    class MarketplaceAggregator {
        -stats: AtomicReference<Stats>
    }
}
Subject <|.. AbstractSubject
AbstractSubject <|-- PriceService
AbstractSubject <|-- InventoryService
AbstractSubject <|-- MarketplaceAggregator
Observer <|.. MarketplaceAggregator

package "observer.listeners" {
    class WishlistNotifier
    class SearchCacheInvalidator
    class AnalyticsTracker
    class InventoryAuditor
    class MarketTrendDashboard
    class PromotionTicketDesk
    class PriceDropAlertService {
        -catalog: Catalog
        -inspector: InventoryValueVisitor
        +onEvent(e: PriceChangedEvent)
    }
}
Observer <|.. WishlistNotifier
Observer <|.. SearchCacheInvalidator
Observer <|.. AnalyticsTracker
Observer <|.. InventoryAuditor
Observer <|.. MarketTrendDashboard
Observer <|.. PromotionTicketDesk
Observer <|.. PriceDropAlertService
AbstractSubject <|-- PriceDropAlertService

package "visitor.api" {
    interface CatalogElement {
        +<R> accept(v: CatalogVisitor<R>): R
    }
    interface "CatalogVisitor<R>" as CatalogVisitor {
        +visit(Catalog): R
        +visit(Category): R
        +visit(PhysicalProduct): R
        +visit(DigitalProduct): R
        +visit(ServiceProduct): R
        +visit(SubscriptionProduct): R
        +visit(GiftCardProduct): R
    }
}

package "visitor.elements" {
    class Catalog
    class Category
    class PhysicalProduct
    class DigitalProduct
    class ServiceProduct
    class SubscriptionProduct
    class GiftCardProduct
}
CatalogElement <|.. Catalog
CatalogElement <|.. Category
CatalogElement <|.. PhysicalProduct
CatalogElement <|.. DigitalProduct
CatalogElement <|.. ServiceProduct
CatalogElement <|.. SubscriptionProduct
CatalogElement <|.. GiftCardProduct
Catalog "1" *-- "*" Category
Category "1" *-- "*" CatalogElement : children

package "visitor.visitors" {
    abstract class "AggregatingCatalogVisitor<R>" as AggregatingCatalogVisitor {
        #empty(): R
        #combine(left: R, right: R): R
        +visit(Catalog): R <<final>>
        +visit(Category): R <<final>>
    }
    class ShippingCostVisitor
    class InventoryValueVisitor
    class ProductFilterVisitor
    class PriceTagFormattingVisitor
    class XmlExportVisitor
    class InventoryReport <<record>>
}
CatalogVisitor <|.. AggregatingCatalogVisitor
CatalogVisitor <|.. XmlExportVisitor
AggregatingCatalogVisitor <|-- ShippingCostVisitor
AggregatingCatalogVisitor <|-- InventoryValueVisitor
AggregatingCatalogVisitor <|-- ProductFilterVisitor
AggregatingCatalogVisitor <|-- PriceTagFormattingVisitor
InventoryValueVisitor ..> InventoryReport : returns

PriceService ..> PriceChangedEvent : publishes
InventoryService ..> StockChangedEvent : publishes
MarketplaceAggregator ..> MarketTrendEvent : publishes
PriceDropAlertService ..> InspectionReportEvent : publishes
PriceDropAlertService --> Category : inspects subtree
PriceDropAlertService --> InventoryValueVisitor : runs
@enduml
